{
  "name": "just-llmprice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:update": "node scripts/generate-price-data.mjs && node scripts/generate-benchmark-data.mjs",
    "benchmark:update": "node scripts/generate-benchmark-data.mjs",
    "prebuild": "node scripts/generate-price-data.mjs --prefer-local && node scripts/generate-benchmark-data.mjs --prefer-local",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "expression:lint": "node scripts/lint-product-expression.mjs",
    "hooks:install": "node scripts/install-product-expression-hook.mjs",
    "quality": "npm run lint && npm run expression:lint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
